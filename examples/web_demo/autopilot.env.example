# Copy to your shell or a local env file (do not commit secrets).
# Never put raw private keys in environment variables; use `rubric-autopilot import-key`
# and AUTOPILOT_KEYSTORE_PASSWORD only for non-dry-run. See AUTOPILOT.md at repo root.

# Data directory for policy.json, audit log, state, pause file (default: ~/.rubric_autopilot)
# AUTOPILOT_DATA_DIR=

# Default true: log intended actions without sending transactions or requiring RPC.
AUTOPILOT_DRY_RUN=true

# Absolute or repo-relative path to a JSON list of forecast candidates (when set, OpenClaw API is not used for scanning).
# Read-write demo file: examples/lifefun_candidates.json
AUTOPILOT_CANDIDATES_FILE=examples/lifefun_candidates.json

# Poll interval for `rubric-autopilot run --loop` (seconds)
# AUTOPILOT_POLL_INTERVAL=60

# OpenClaw / LifeFun-style API (used when AUTOPILOT_CANDIDATES_FILE is unset)
# OPENCLAW_BASE_URL=https://api.example.com
# OPENCLAW_API_KEY=
# LIFEFUN_JWT=
# LIFEFUN_JWT_FILE=
# LIFEFUN_LOGIN_ADDRESS=
# LIFEFUN_LOGIN_SIGNATURE_SOURCE=

# EVM JSON-RPC and chain (non-dry-run execution)
# AUTOPILOT_RPC_URL=
AUTOPILOT_CHAIN_ID=56

# Keystore (default path under AUTOPILOT_DATA_DIR: executor.keystore)
# AUTOPILOT_KEYSTORE_PATH=
# Unlock password for keystore (non-dry-run)
# AUTOPILOT_KEYSTORE_PASSWORD=

# Execution: eoa (default) or session (function whitelist)
# AUTOPILOT_EXECUTION_MODE=eoa

# ERC-4337 bundler URL if using account-abstraction path (optional; see AUTOPILOT.md)
# AUTOPILOT_BUNDLER_URL=

# Decision thresholds
# AUTOPILOT_MIN_SCORE=0.55
# AUTOPILOT_MAX_ACTIONS_PER_CYCLE=5
